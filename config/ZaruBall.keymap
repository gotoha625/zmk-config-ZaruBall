//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 500
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        login: login {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INT_MUHENKAN &kp LS(R) &kp U &kp R &kp U &kp R &kp U &kp LS(R) &kp U &kp K &kp I &kp A &kp N6 &kp N2 &kp N5>;
            label = "LOGIN";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>;
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4     &kp N5                  &kp F5  &kp F10       &kp F11       &kp F12                    &kp NUMBER_6  &kp N7  &kp N8     &kp N9   &kp N0    &kp TILDE
&kp TAB    &kp Q   &kp W   &kp E     &kp R      &kp T                   &kp F3  &kp N7        &kp N8        &kp N9                     &kp Y         &kp U   &kp I      &kp O    &kp P     &kp EQUAL
&kp MINUS  &kp A   &kp S   &kp D     &kp F      &kp G   &kp LEFT_ALT    &kp F7  &kp NUMBER_4  &kp N5        &kp NUMBER_6    &kp LBKT   &kp H         &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V      &kp B   &kp SPACE       &kp N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp RBKT   &kp N         &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSLASH
&kp LCTRL  &none           &kp LWIN  &mkp RCLK  &mo 2   &mkp LCLK                                                           &lt 3 RET  &kp BSPC                                            &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&to_layer_0 ESC  &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5            &trans  &trans  &trans  &trans            &to_layer_0 N6  &to_layer_0 N7  &to_layer_0 N8     &to_layer_0 N9      &to_layer_0 N0            &to_layer_0 MINUS
&to_layer_0 TAB  &to_layer_0 Q   &to_layer_0 W   &to_layer_0 E   &to_layer_0 R   &to_layer_0 T             &trans  &trans  &trans  &trans            &to_layer_0 Y   &to_layer_0 U   &to_layer_0 I      &to_layer_0 O       &to_layer_0 P             &to_layer_0 EQUAL
&trans           &to_layer_0 A   &to_layer_0 S   &to_layer_0 D   &to_layer_0 F   &to_layer_0 G   &trans    &trans  &trans  &trans  &trans    &trans  &to_layer_0 H   &mkp LCLK       &to_layer_0 K      &to_layer_0 L       &to_layer_0 SINGLE_QUOTE  &to_layer_0 SEMICOLON
&trans           &to_layer_0 Z   &to_layer_0 X   &to_layer_0 C   &to_layer_0 V   &to_layer_0 B   &trans    &trans  &trans  &trans  &trans    &trans  &to_layer_0 N   &to_layer_0 M   &to_layer_0 COMMA  &to_layer_0 PERIOD  &to_layer_0 SLASH         &to_layer_0 NON_US_BACKSLASH
&trans           &trans                          &trans          &trans          &trans          &trans                                      &trans  &trans                                                                                           &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
&trans       &kp F1   &kp F2   &kp F3                  &kp F4             &kp F5             &trans  &trans  &trans  &trans                      &trans          &trans     &trans    &trans     &trans  &trans
&kp LA(TAB)  &kp F6   &kp F7   &kp F8                  &kp F9             &kp F10            &trans  &trans  &trans  &trans                      &trans          &kp EQUAL  &kp UP    &kp SQT    &trans  &trans
&trans       &kp F11  &kp F12  &kp LS(LG(LEFT_ARROW))  &kp LS(LG(RIGHT))  &trans   &trans    &trans  &trans  &trans  &trans    &trans            &mkp MB4        &kp LEFT   &kp DOWN  &kp RIGHT  &kp F9  &trans
&trans       &trans   &trans   &kp LG(LEFT)            &kp LG(RIGHT)      &trans   &trans    &trans  &trans  &trans  &trans    &mo 3             &mkp MB5        &kp LBKT   &kp RBKT  &trans     &trans  &trans
&trans       &trans            &trans                  &trans             &trans   &trans                                      &kp INT_MUHENKAN  &kp INT_HENKAN                                          &studio_unlock
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
            bindings = <
&trans  &none   &none   &none   &none   &none             &trans  &trans  &trans  &trans            &none   &none     &none     &none   &none    &none
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5            &trans  &trans  &trans  &trans            &kp F6  &kp F7    &kp F8    &kp F9  &kp F10  &none
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none     &trans  &trans  &trans  &trans    &none   &kp N6  &kp N7    &kp N8    &kp N9  &kp N0   &none
&trans  &none   &none   &none   &none   &none   &trans    &trans  &trans  &trans  &trans    &trans  &none   &kp LPAR  &kp RPAR  &none   &none    &none
&trans  &none           &trans  &trans  &trans  &trans                                      &trans  &trans                                       &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans            &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &login        &none                   &trans  &trans  &trans  &trans            &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &none   &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &none   &none           &none  &none  &none  &none  &none
&trans  &none                       &trans        &trans        &trans        &trans                                      &trans  &trans                                      &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
